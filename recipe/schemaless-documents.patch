@@ -253,6 +253,23 @@ def _process_all(
 _api_remove = remove  # alias to prevent shadowing in the function below
 
 
+def _is_legacy_metadata(metadata: dict) -> bool:
+    """
+    Whether a menu document uses the menuinst v1.x format.
+
+    `$schema` cannot be the only discriminator: dropping it is the documented
+    way to opt a document out of conda-build's schema validation, and a v2
+    document that does so must still be installed as v2. Every v2 menu item
+    carries a `platforms` key, which no v1 item has, so fall back to that.
+    """
+    if "$schema" in metadata or "$id" in metadata:
+        return False
+    return not any(
+        isinstance(item, dict) and "platforms" in item
+        for item in metadata.get("menu_items", [])
+    )
+
