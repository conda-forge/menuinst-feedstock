+def test_validate_skipped_without_schema_key(tmp_path):
+    """A document with no `$schema` key opts out of validation entirely."""
+    from menuinst._schema import validate
+
+    doc = {
+        "menu_name": "Test",
+        "menu_items": [
+            {
+                "name": "Test Item",
+                "description": "d",
+                "command": ["echo", "hi"],
+                # A key no published schema revision knows about.
+                "platforms": {"linux": {"run_in_bash": False}},
+            }
+        ],
+    }
+    assert validate(doc) is None
+
+    path = tmp_path / "menu.json"
+    path.write_text(json.dumps(doc))
+    assert validate(path) is None
+
+    # With the key present, validation still runs.
+    doc_with_schema = dict(doc, **{"$schema": SCHEMA_URL})
+    assert validate(doc_with_schema) is not None
+
+
+def test_schemaless_v2_document_is_not_treated_as_legacy():
+    """Dropping `$schema` must not route a v2 document into the v1 installer."""
+    from menuinst.api import _is_legacy_metadata
+
+    v2 = {
+        "menu_name": "Test",
+        "menu_items": [{"name": "n", "command": ["echo"], "platforms": {"linux": {}}}],
+    }
+    assert not _is_legacy_metadata(v2)
+    assert not _is_legacy_metadata(dict(v2, **{"$schema": SCHEMA_URL}))
+
+    v1 = {
+        "menu_name": "Test",
+        "menu_items": [{"name": "n", "system": "cmd.exe", "scriptarguments": []}],
+    }
+    assert _is_legacy_metadata(v1)
+    assert _is_legacy_metadata({"menu_name": "Test", "menu_items": []})
