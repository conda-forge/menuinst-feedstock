 def validate(metadata_or_path):
+    """
+    Validate a menu document against the schema.
+
+    Documents that do not carry a `$schema` key are not validated, and None is
+    returned. This mirrors how conda-build treats such documents, and lets a
+    document opt out of validation when it targets a schema revision that is
+    not published at schemas.conda.org yet.
+    """
     if isinstance(metadata_or_path, (str, Path)):
         with open(metadata_or_path) as f:
             metadata = json.load(f)
     else:
         metadata = metadata_or_path
+    if "$schema" not in metadata:
+        log.info("No `$schema` key found; skipping validation.")
+        return None
     return MenuInstSchema(**metadata)
 
 
